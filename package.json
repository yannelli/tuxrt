{
  "name": "tuxrt",
  "version": "0.1.0",
  "description": "A TypeScript runtime that emulates an Ubuntu 24.04 Linux CLI: virtual filesystem, POSIX-style shell, and core utilities.",
  "license": "MIT",
  "author": "Ryan Yannelli",
  "type": "module",
  "bin": {
    "tuxrt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/runtime.js"
    },
    "./portable": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./bundle": "./dist/tuxrt.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json && npm run bundle",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "bundle": "esbuild src/runtime.ts --bundle --format=iife --global-name=tuxrt --target=es2020 --log-level=warning --outfile=dist/tuxrt.js",
    "test:portable": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
