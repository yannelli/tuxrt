{
  "name": "tuxrt",
  "version": "0.1.0",
  "description": "A TypeScript runtime that emulates an Ubuntu 24.04 Linux CLI: virtual filesystem, POSIX-style shell, and core utilities.",
  "type": "module",
  "bin": { "tuxrt": "./src/cli.ts" },
  "exports": "./src/runtime.ts",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
