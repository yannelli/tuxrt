{
  "name": "tuxrt",
  "version": "0.1.0",
  "description": "A TypeScript runtime that emulates an Ubuntu 24.04 Linux CLI: virtual filesystem, POSIX-style shell, and core utilities.",
  "license": "MIT",
  "author": "Ryan Yannelli",
  "type": "module",
  "bin": {
    "tuxrt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
